---
/** Diagram: the five readiness signals HQ checks before moving a mandate. */
import Icon from '../../Icon.astro';
const signals = [
  { icon: 'user-round-check', title: 'Managers decide', body: 'Local decisions, fewer escalations' },
  { icon: 'arrow-right-left', title: 'Clean last transition', body: 'Phases, risks and exit criteria' },
  { icon: 'briefcase-business', title: 'Business understanding', body: 'Outcomes, not effort' },
  { icon: 'sparkles', title: 'A view on AI', body: 'Shared literacy and a plan' },
  { icon: 'globe', title: 'Trusted relationships', body: 'Clear, constructive, across time zones' },
];
---

<div class="p-5 md:p-8" role="img" aria-label="Diagram: five readiness signals, from managers who decide to trusted relationships, leading to a bigger mandate">
  <p class="text-center text-xs font-bold tracking-widest text-slate uppercase">The five readiness signals</p>
  <ol class="relative mt-6 grid gap-3 sm:grid-cols-5 sm:gap-2">
    <li aria-hidden="true" class="absolute top-7 right-[10%] left-[10%] hidden h-0.5 bg-line sm:block"></li>
    {
      signals.map((s, i) => (
        <li class="relative flex items-center gap-4 rounded-xl bg-white p-3 sm:flex-col sm:bg-transparent sm:p-0 sm:text-center">
          <span class="relative z-10 inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-teal bg-white text-teal">
            <Icon name={s.icon} size={24} />
            <span class="absolute -top-1 -right-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-saffron font-heading text-[0.7rem] font-extrabold text-navy">
              {i + 1}
            </span>
          </span>
          <span>
            <span class="block font-heading text-[0.95rem] leading-snug font-bold text-navy">{s.title}</span>
            <span class="mt-0.5 block text-sm leading-snug text-slate">{s.body}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <div class="mt-6 flex items-center justify-center gap-3">
    <span class="h-px flex-1 bg-line"></span>
    <span class="inline-flex items-center gap-2 rounded-full bg-navy px-4 py-2 font-heading text-sm font-bold text-white">
      <span class="h-2.5 w-2.5 rounded-full bg-saffron"></span> A bigger mandate
    </span>
    <span class="h-px flex-1 bg-line"></span>
  </div>
</div>
