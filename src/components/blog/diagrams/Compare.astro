---
/**
 * Two-column comparison (from → to). Use inside <Figure>:
 *   <Compare label="…" left="Services mindset" right="Captive mindset" rows={[['…', '…'], …]} />
 */
import Icon from '../../Icon.astro';
interface Props {
  label: string;
  left: string;
  right: string;
  rows: [string, string][];
}
const { label, left, right, rows } = Astro.props;
---

<div class="p-5 md:p-8" role="img" aria-label={label}>
  <div class="grid grid-cols-2 gap-3 text-center">
    <p class="rounded-lg bg-white px-3 py-2 font-heading text-sm font-bold text-slate">{left}</p>
    <p class="rounded-lg bg-navy px-3 py-2 font-heading text-sm font-bold text-white">{right}</p>
  </div>
  <ul class="mt-3 space-y-2.5">
    {
      rows.map(([a, b]) => (
        <li class="grid grid-cols-2 gap-3 text-sm leading-snug md:text-[0.95rem]">
          <span class="flex items-start gap-2 rounded-lg border border-line bg-white p-3 text-slate">
            <Icon name="minus" size={18} class="mt-0.5 shrink-0" />
            {a}
          </span>
          <span class="flex items-start gap-2 rounded-lg border border-teal/40 bg-white p-3 font-medium text-navy">
            <Icon name="check" size={18} strokeWidth={2.5} class="mt-0.5 shrink-0 text-teal" />
            {b}
          </span>
        </li>
      ))
    }
  </ul>
</div>
