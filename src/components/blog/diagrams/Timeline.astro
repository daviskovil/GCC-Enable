---
/**
 * Phased timeline. Use inside <Figure>:
 *   <Timeline label="…" title="…" phases={[{ when: 'Weeks 1–4', title: '…', points: ['…'] }, …]} />
 */
interface Props {
  label: string;
  title?: string;
  phases: { when: string; title: string; points: string[] }[];
}
const { label, title, phases } = Astro.props;
const cols = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' }[phases.length] ?? 'md:grid-cols-3';
---

<div class="p-5 md:p-8" role="img" aria-label={label}>
  {title && <p class="text-center text-xs font-bold tracking-widest text-slate uppercase">{title}</p>}
  <ol class:list={['mt-6 grid gap-4', cols]}>
    {
      phases.map((p, i) => (
        <li class="relative overflow-hidden rounded-xl border border-line bg-white">
          <div class:list={['px-4 py-3', i === phases.length - 1 ? 'bg-navy text-white' : 'bg-white']}>
            <p class:list={['text-xs font-bold tracking-wider uppercase', i === phases.length - 1 ? 'text-saffron' : 'text-slate']}>
              {p.when}
            </p>
            <p class:list={['mt-0.5 font-heading font-bold', i === phases.length - 1 ? 'text-white' : 'text-navy']}>{p.title}</p>
          </div>
          <div class="h-1 bg-line">
            <div class="h-1 bg-teal" style={`width:${Math.round(((i + 1) / phases.length) * 100)}%`} />
          </div>
          <ul class="space-y-1.5 px-4 py-3 text-sm leading-snug text-ink">
            {p.points.map((pt) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal" />
                {pt}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</div>
