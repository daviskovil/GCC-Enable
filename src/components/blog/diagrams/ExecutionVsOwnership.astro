---
/** Diagram: how HQ reads an execution centre versus an ownership centre. */
import Icon from '../../Icon.astro';
const rows = [
  ['Escalates non-routine decisions to HQ', 'Decides locally and briefs HQ afterwards'],
  ['Reports effort, tickets and utilisation', 'Reports outcomes for the business'],
  ['Waits for a fully formed backlog', 'Shapes the roadmap with product owners'],
  ['Follows HQ on AI', 'Brings a plan for AI in its own work'],
  ['Says yes, then misses dates', 'Pushes back early, then delivers'],
];
---

<div class="p-5 md:p-8" role="img" aria-label="Comparison: execution centre versus ownership centre across five behaviours">
  <div class="grid grid-cols-2 gap-3 text-center">
    <p class="rounded-lg bg-white px-3 py-2 font-heading text-sm font-bold text-slate">Seen as an execution centre</p>
    <p class="rounded-lg bg-navy px-3 py-2 font-heading text-sm font-bold text-white">Seen as an ownership centre</p>
  </div>
  <ul class="mt-3 space-y-2.5">
    {
      rows.map(([a, b]) => (
        <li class="grid grid-cols-2 gap-3 text-sm leading-snug md:text-[0.95rem]">
          <span class="flex items-start gap-2 rounded-lg border border-line bg-white p-3 text-slate">
            <Icon name="minus" size={18} class="mt-0.5 shrink-0" />
            {a}
          </span>
          <span class="flex items-start gap-2 rounded-lg border border-teal/40 bg-white p-3 font-medium text-navy">
            <Icon name="check" size={18} strokeWidth={2.5} class="mt-0.5 shrink-0 text-teal" />
            {b}
          </span>
        </li>
      ))
    }
  </ul>
</div>
