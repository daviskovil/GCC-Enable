---
/** Image or diagram with a caption. Pass `src` (an imported image) or put an inline SVG component in the slot. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src?: ImageMetadata;
  alt?: string;
  caption?: string;
  wide?: boolean;
}
const { src, alt = '', caption, wide = false } = Astro.props;
---

<figure class:list={['not-prose my-10', wide && 'md:-mx-16']}>
  <div class="overflow-hidden rounded-[14px] border border-line bg-mist">
    {src ? <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(min-width: 768px) 768px, 100vw" class="h-auto w-full" /> : <slot />}
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-slate">{caption}</figcaption>}
</figure>
