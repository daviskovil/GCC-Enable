---
/**
 * Renders an optimised photo if one exists in src/assets/images/ (e.g. hero.jpg, about.jpg),
 * otherwise renders the slot (an SVG fallback). Drop a file in that folder to switch it on.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: 'hero' | 'about' | 'founder';
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}
const { name, alt, class: className = '', widths = [480, 800, 1200], sizes = '(min-width: 1024px) 560px, 100vw', priority = false } =
  Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.split('.')[0] === name);
const img = match?.[1].default;
---

{
  img ? (
    <Image
      src={img}
      alt={alt}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  ) : (
    <slot />
  )
}
