---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { programmesByTopic, customWorkshop } from '../data/programmes';
import { mainNav, isGroupActive } from '../data/navigation';
import { site } from '../config/site';

const path = Astro.url.pathname;
const activeClass = 'underline decoration-saffron decoration-2 underline-offset-8';
const lastIndex = mainNav.length - 1;
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-white transition-shadow duration-300">
  <div class="container-site relative flex h-[76px] items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((group, gi) => {
            const active = isGroupActive(group, path);
            if (group.kind === 'link')
              return (
                <li>
                  <a
                    href={group.href}
                    class:list={['rounded-md px-3 py-2 font-semibold text-navy hover:bg-mist', active && activeClass]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {group.label}
                  </a>
                </li>
              );
            const menuId = `menu-${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}`;
            return (
              <li class={group.kind === 'dropdown' ? 'relative' : ''} data-dropdown>
                <button
                  type="button"
                  class:list={['inline-flex items-center gap-1 rounded-md px-3 py-2 font-semibold text-navy hover:bg-mist', active && activeClass]}
                  aria-expanded="false"
                  aria-controls={menuId}
                  data-dropdown-trigger
                >
                  {group.label}
                  <Icon name="chevron-down" size={16} class="transition-transform duration-200" />
                </button>
                {group.kind === 'mega' ? (
                  <div id={menuId} class="absolute inset-x-4 top-full hidden pt-1 sm:inset-x-6 lg:inset-x-8" data-dropdown-panel>
                    <div class="card p-6">
                      <ul class="grid grid-cols-4 gap-x-6 gap-y-7">
                        {programmesByTopic.map(({ topic, programmes: list }) => (
                          <li>
                            <a
                              href={`/programmes/#${topic.slug}`}
                              class="flex items-center gap-2 text-xs font-bold tracking-wider text-slate uppercase hover:text-navy"
                            >
                              <Icon name={topic.icon} size={16} class="shrink-0 text-teal" />
                              {topic.short}
                            </a>
                            <ul class="mt-2.5 space-y-1">
                              {list.map((p) => (
                                <li>
                                  <a
                                    href={`/programmes/${p.slug}/`}
                                    class="-mx-2 block rounded-md px-2 py-1.5 font-heading text-[0.95rem] leading-snug font-bold text-navy hover:bg-mist"
                                  >
                                    {p.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </li>
                        ))}
                      </ul>
                      <div class="mt-6 flex items-center justify-between gap-4 rounded-lg bg-mist px-4 py-3 text-sm">
                        <span class="text-slate">{customWorkshop.summary}</span>
                        <a href="/programmes/" class="link-arrow shrink-0">
                          All programmes <Icon name="arrow-right" size={16} />
                        </a>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div
                    id={menuId}
                    class:list={['absolute top-full hidden w-[400px] pt-3', gi === lastIndex ? 'right-0' : 'left-0']}
                    data-dropdown-panel
                  >
                    <ul class="card p-2.5">
                      {group.items!.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            class="flex gap-3 rounded-lg p-3 hover:bg-mist"
                            aria-current={path === item.href ? 'page' : undefined}
                          >
                            {item.icon && (
                              <span class="icon-tile h-10 w-10">
                                <Icon name={item.icon} size={20} />
                              </span>
                            )}
                            <span>
                              <span class="block font-heading leading-snug font-bold text-navy">{item.label}</span>
                              {item.description && <span class="block text-sm leading-snug text-slate">{item.description}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.bookingPage} class="btn btn-primary hidden sm:inline-flex">Book a discovery call</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-navy hover:bg-mist lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    data-menu
  >
    <div class="absolute inset-0 bg-navy/40 opacity-0 transition-opacity duration-300" data-menu-backdrop></div>
    <div
      class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col overflow-y-auto bg-white transition-transform duration-300"
      data-menu-panel
    >
      <div class="flex h-[76px] shrink-0 items-center justify-between border-b border-line px-4 sm:px-6">
        <Logo />
        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-navy hover:bg-mist"
          aria-label="Close menu"
          data-menu-close
        >
          <Icon name="x" size={26} />
        </button>
      </div>
      <nav aria-label="Mobile" class="flex-1 px-4 py-4 sm:px-6">
        <ul class="divide-y divide-line">
          {
            mainNav.map((group, gi) => {
              if (group.kind === 'link')
                return (
                  <li>
                    <a href={group.href} class="block py-4 font-heading text-lg font-bold text-navy">
                      {group.label}
                    </a>
                  </li>
                );
              const items =
                group.kind === 'mega'
                  ? [
                      ...programmesByTopic.map(({ topic }) => ({ label: topic.short, href: `/programmes/#${topic.slug}`, icon: topic.icon })),
                      { label: 'All programmes', href: '/programmes/', icon: 'arrow-right' },
                    ]
                  : group.items!;
              const panelId = `m-panel-${gi}`;
              return (
                <li>
                  <button
                    type="button"
                    class="flex w-full items-center justify-between py-4 text-left font-heading text-lg font-bold text-navy"
                    aria-expanded="false"
                    aria-controls={panelId}
                    data-accordion-trigger
                  >
                    {group.label}
                    <span class="acc-icon inline-flex h-8 w-8 items-center justify-center rounded-full bg-teal/10 text-teal">
                      <Icon name="plus" size={18} />
                    </span>
                  </button>
                  <div id={panelId} class="accordion-panel" data-open="false" inert>
                    <div>
                      <ul class="space-y-0.5 pb-4">
                        {items.map((item) => (
                          <li>
                            <a href={item.href} class="flex items-center gap-3 rounded-lg px-2 py-2.5 font-semibold text-navy hover:bg-mist">
                              {item.icon && <Icon name={item.icon} size={20} class="shrink-0 text-teal" />}
                              {item.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div class="border-t border-line p-4 sm:p-6">
        <a href={site.bookingPage} class="btn btn-primary w-full">Book a discovery call</a>
        <a href={`mailto:${site.email}`} class="mt-4 flex items-center justify-center gap-2 text-sm font-semibold text-navy">
          <Icon name="mail" size={16} class="text-teal" />{site.email}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header.classList.toggle('shadow-header', scrolled);
    header.classList.toggle('border-line', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Desktop dropdown: hover on pointer devices, click and keyboard everywhere
  // Only one dropdown open at a time
  const closers: ((open: boolean) => void)[] = [];
  document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
    const panel = dd.querySelector<HTMLElement>('[data-dropdown-panel]')!;
    const chevron = trigger.querySelector('svg');
    let closeTimer: number | undefined;

    const setOpen = (open: boolean) => {
      if (open) closers.forEach((close) => close !== setOpen && close(false));
      trigger.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      chevron?.classList.toggle('rotate-180', open);
    };
    closers.push(setOpen);
    // Mouse users already opened it on hover, so a click keeps it open; keyboard and touch toggle
    trigger.addEventListener('click', (e) => {
      const isMouse = (e as PointerEvent).pointerType === 'mouse';
      setOpen(isMouse ? true : trigger.getAttribute('aria-expanded') !== 'true');
    });
    dd.addEventListener('mouseenter', () => {
      window.clearTimeout(closeTimer);
      setOpen(true);
    });
    dd.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(() => setOpen(false), 150);
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        trigger.focus();
      }
      if (e.key === 'ArrowDown' && document.activeElement === trigger) {
        e.preventDefault();
        setOpen(true);
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node)) setOpen(false);
    });
  });

  // Mobile slide-in menu
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const panel = menu.querySelector<HTMLElement>('[data-menu-panel]')!;
  const backdrop = menu.querySelector<HTMLElement>('[data-menu-backdrop]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  const openMenu = () => {
    menu.classList.remove('hidden');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      panel.classList.remove('translate-x-full');
      backdrop.classList.remove('opacity-0');
    });
    closeBtn.focus();
  };
  const closeMenu = () => {
    panel.classList.add('translate-x-full');
    backdrop.classList.add('opacity-0');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => menu.classList.add('hidden'), 300);
    openBtn.focus();
  };
  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);
  backdrop.addEventListener('click', closeMenu);
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
    if (e.key === 'Tab') {
      const focusables = [...panel.querySelectorAll<HTMLElement>('a, button')].filter((el) => !el.closest('[inert]'));
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
