---
/** The GCC Enable mark: navy square, white corner arrow, saffron dot. `inverse` swaps to a white square for dark backgrounds. */
interface Props {
  size?: number;
  inverse?: boolean;
  class?: string;
}
const { size = 40, inverse = false, class: className = '' } = Astro.props;
const square = inverse ? '#FFFFFF' : '#0F2A4A';
const arrow = inverse ? '#0F2A4A' : '#FFFFFF';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <rect width="100" height="100" fill={square}></rect>
  <path d="M13.4 13.8H86.2V86.2H72.5V37.3L23.2 86.2 13.4 76.6 62.7 27.5H13.4Z" fill={arrow}></path>
  <circle cx="83.3" cy="14.6" r="9.9" fill="#F5A623"></circle>
</svg>
