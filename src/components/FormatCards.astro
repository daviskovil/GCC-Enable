---
import Icon from './Icon.astro';
import { formats } from '../data/content';
---

<ul class="grid gap-6 md:grid-cols-3">
  {
    formats.map((f) => (
      <li class="card card-hover p-6 md:p-7" data-reveal>
        <span class="icon-tile">
          <Icon name={f.icon} />
        </span>
        <h3 class="mt-5 text-xl font-bold">{f.title}</h3>
        <p class="mt-1 text-sm font-semibold tracking-wide text-slate uppercase">{f.duration}</p>
        <p class="mt-3 text-slate">{f.body}</p>
      </li>
    ))
  }
</ul>
