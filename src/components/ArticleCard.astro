---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { readingTime } from '../utils/readingTime';
interface Props {
  article: CollectionEntry<'blog'>;
}
const { article: a } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="card card-hover group relative flex h-full flex-col p-7">
  <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate">
    <span class="flex items-center gap-1.5">
      <Icon name="calendar" size={15} class="text-teal" />
      <time datetime={a.data.date.toISOString()}>{fmt(a.data.date)}</time>
    </span>
    <span class="flex items-center gap-1.5">
      <Icon name="clock" size={15} class="text-teal" />
      {readingTime(a.body ?? '')} min read
    </span>
  </p>
  <h3 class="mt-3 text-xl leading-snug font-bold">
    <a href={`/resources/blog/${a.id}/`} class="after:absolute after:inset-0 after:rounded-[14px] after:content-['']">
      {a.data.title}
    </a>
  </h3>
  <p class="mt-2 flex-1 text-slate">{a.data.description}</p>
  <span class="link-arrow mt-5" aria-hidden="true">Read article <Icon name="arrow-right" size={18} /></span>
</article>
