---
/** Blog card: share-image thumbnail, category, title, excerpt, reading time and "Read article". */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getTopic, type TopicSlug } from '../data/topics';
import { readingTime } from '../utils/readingTime';
interface Props {
  article: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { article: a, headingLevel: H = 'h3', eager = false } = Astro.props;
const topic = getTopic(a.data.topic as TopicSlug);
---

<article class="card-hover group relative flex h-full flex-col overflow-hidden rounded-[14px] border border-line bg-white shadow-card">
  <div class="aspect-[1200/630] overflow-hidden bg-navy">
    <img
      src={`/og/blog/${a.id}.png`}
      alt=""
      width="1200"
      height="630"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="flex items-center gap-2 text-xs font-bold tracking-wider text-navy uppercase">
      <span class="h-2 w-2 rounded-full bg-saffron"></span>{topic.short}
    </p>
    <H class="mt-2.5 text-lg leading-snug font-bold">
      <a href={`/resources/blog/${a.id}/`} class="after:absolute after:inset-0 after:rounded-[14px] after:content-['']">
        {a.data.title}
      </a>
    </H>
    <p class="mt-2 line-clamp-2 flex-1 text-[0.95rem] text-slate">{a.data.description}</p>
    <div class="mt-5 flex items-center justify-between border-t border-line pt-4 text-sm">
      <span class="flex items-center gap-1.5 text-slate">
        <Icon name="clock" size={15} class="text-teal" />
        {readingTime(a.body ?? '')} min read
      </span>
      <span class="link-arrow text-xs font-bold tracking-wider uppercase" aria-hidden="true">
        Read article <Icon name="arrow-right" size={15} />
      </span>
    </div>
  </div>
</article>
