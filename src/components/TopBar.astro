---
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<div class="bg-navy text-sm text-white/90">
  <div class="container-site flex h-9 items-center justify-between gap-4">
    <p class="truncate">
      <span class="hidden sm:inline">Training and workshops built only for India’s Global Capability Centres (GCCs) · </span>
      <span class="sm:hidden">Global Capability Centres · </span>Pune
    </p>
    <a href={`mailto:${site.email}`} class="inline-flex shrink-0 items-center gap-1.5 hover:text-white hover:underline">
      <Icon name="mail" size={15} />
      <span class="hidden md:inline">{site.email}</span>
      <span class="md:hidden">Email us</span>
    </a>
  </div>
</div>
