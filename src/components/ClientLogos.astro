---
/** Hidden unless site.showClientLogos is true. Only add logos you have written permission to use. */
import { site } from '../config/site';
import { clientLogos } from '../data/content';
---

{
  site.showClientLogos && (
    <section class="border-y border-line py-12" aria-labelledby="clients-heading">
      <div class="container-site">
        <h2 id="clients-heading" class="text-center text-sm font-semibold tracking-wide text-slate uppercase">
          Trusted by GCCs across India
        </h2>
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
          {clientLogos.map((c) => (
            <li class="flex h-12 items-center">
              {c.src ? (
                <img src={c.src} alt={c.name} class="h-10 w-auto opacity-70 grayscale" loading="lazy" />
              ) : (
                <span class="rounded-lg border border-dashed border-line px-4 py-2 text-sm text-slate">{c.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
