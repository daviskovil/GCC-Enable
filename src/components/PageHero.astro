---
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
  breadcrumb?: { label: string; href?: string }[];
}
const { title, intro, eyebrow, breadcrumb } = Astro.props;
---

<section class="bg-dots-light relative overflow-hidden border-b border-line bg-mist">
  <div class="container-site py-12 md:py-20">
    {
      breadcrumb && (
        <div class="mb-8">
          <Breadcrumb items={breadcrumb} />
        </div>
      )
    }
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <h1 class="h-accent text-4xl font-extrabold md:text-5xl">{title}</h1>
      {intro && <p class="mt-5 text-lg text-slate md:text-xl">{intro}</p>}
      <slot />
    </div>
  </div>
</section>
