---
import Icon from './Icon.astro';
import { processSteps } from '../data/content';
---

<ol class="relative grid gap-8 md:grid-cols-4 md:gap-6">
  <li aria-hidden="true" class="pointer-events-none absolute top-7 bottom-7 left-7 w-0.5 bg-line md:right-[12.5%] md:bottom-auto md:left-[12.5%] md:h-0.5 md:w-auto"></li>
  {
    processSteps.map((s, i) => (
      <li class="relative flex gap-5 md:flex-col md:items-center md:text-center" data-reveal>
        <span class="relative z-10 inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-teal bg-white text-teal">
          <Icon name={s.icon} />
          <span class="absolute -top-1.5 -right-1.5 inline-flex h-6 w-6 items-center justify-center rounded-full bg-saffron font-heading text-xs font-extrabold text-navy">
            {i + 1}
          </span>
        </span>
        <div>
          <h3 class="text-xl font-bold md:mt-5">{s.title}</h3>
          <p class="mt-1.5 text-slate">{s.short}</p>
        </div>
      </li>
    ))
  }
</ol>
