---
import Icon from './Icon.astro';
import { customWorkshop } from '../data/programmes';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: H = 'h3' } = Astro.props;
---

<article
  class="card-hover group relative flex h-full flex-col rounded-[14px] border-2 border-dashed border-teal/50 bg-mist p-6 md:p-7"
>
  <span class="icon-tile bg-white"><Icon name={customWorkshop.icon} /></span>
  <H class="mt-5 text-xl font-bold">
    <a href={customWorkshop.href} class="after:absolute after:inset-0 after:rounded-[14px] after:content-['']">
      {customWorkshop.title}
    </a>
  </H>
  <p class="mt-2 flex-1 text-slate">{customWorkshop.summary}</p>
  <span class="link-arrow mt-5" aria-hidden="true">Talk to us <Icon name="arrow-right" size={18} /></span>
</article>
