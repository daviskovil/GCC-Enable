---
import Icon from './Icon.astro';
import { site } from '../config/site';
interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
}
const {
  title = 'Let’s talk about your centre’s next mandate.',
  text = 'A 30-minute discovery call to understand what HQ is asking of your centre, and whether we can help.',
  buttonLabel = 'Book a discovery call',
} = Astro.props;
---

<section class="container-site py-16 md:py-20" aria-labelledby="cta-heading">
  <div class="bg-dark-pattern relative overflow-hidden rounded-[18px] px-6 py-12 text-center md:px-12 md:py-16" data-reveal>
    <svg class="pointer-events-none absolute -top-10 -right-10 h-56 w-56 opacity-[0.10]" viewBox="0 0 100 100" aria-hidden="true">
      <path d="M13.4 13.8H86.2V86.2H72.5V37.3L23.2 86.2 13.4 76.6 62.7 27.5H13.4Z" fill="#fff"></path>
    </svg>
    <h2 id="cta-heading" class="relative mx-auto max-w-2xl text-3xl font-extrabold text-white md:text-4xl">{title}</h2>
    <p class="relative mx-auto mt-4 max-w-xl text-lg text-white/80">{text}</p>
    <div class="relative mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/contact/" class="btn btn-primary">{buttonLabel} <Icon name="arrow-right" size={18} /></a>
      <a
        href={`mailto:${site.email}`}
        class="font-semibold text-white underline decoration-saffron decoration-2 underline-offset-4 hover:text-white/90"
      >
        or email us
      </a>
    </div>
  </div>
</section>
