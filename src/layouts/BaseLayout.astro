---
import '../styles/global.css';
import BaseHead, { type SeoProps } from '../components/BaseHead.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';

type Props = SeoProps;
const props = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead {...props} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-form-handler={site.formHandler} data-web3forms-key={site.web3formsKey}>
    <a
      href="#main"
      class="sr-only z-[70] rounded-lg bg-saffron px-4 py-3 font-semibold text-navy focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to main content
    </a>
    {site.showTopBar && <TopBar />}
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      import '../scripts/ui.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
