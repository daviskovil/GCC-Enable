---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import LogoMark from '../components/LogoMark.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OptionalImage from '../components/OptionalImage.astro';
import CtaBand from '../components/CtaBand.astro';
import { about, faculty, puneStat } from '../data/content';
import { site } from '../config/site';
---

<BaseLayout
  title="About"
  description="Why GCC Enable exists: India’s GCCs are moving from execution to ownership, and training has not caught up. A training company built only for GCCs, based in Pune."
>
  <PageHero title="About GCC Enable" intro={about.intro} breadcrumb={[{ label: 'About' }]} />

  <section class="section" aria-labelledby="story-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div data-reveal>
        <SectionHeading id="story-heading" title="Why we exist" />
        {about.story.map((p) => <p class="mt-5 text-lg text-slate">{p}</p>)}
        <p class="mt-6 text-xs text-slate">Pune GCC figure: {puneStat.value} {puneStat.label}. Source: {puneStat.source}.</p>
      </div>
      <div data-reveal>
        <OptionalImage name="about" alt="GCC Enable team at work" class="w-full rounded-[18px] shadow-card">
          <div class="bg-dark-pattern relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[18px]">
            <LogoMark size={140} inverse />
            <span class="absolute bottom-6 left-6 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold text-white">
              {site.shortTagline}
            </span>
          </div>
        </OptionalImage>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-20" aria-labelledby="mission-heading">
    <div class="container-site text-center">
      <h2 id="mission-heading" class="text-sm font-bold tracking-widest text-slate uppercase">Our mission</h2>
      <p class="mx-auto mt-5 max-w-3xl font-heading text-2xl leading-snug font-extrabold text-navy md:text-4xl">
        {about.mission}
      </p>
    </div>
  </section>

  <!-- Founder -->
  <section class="section" aria-labelledby="founder-heading">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[380px_1fr] lg:gap-16">
      <figure class="mx-auto w-full max-w-[380px] lg:sticky lg:top-28" data-reveal>
        <div class="relative">
          <div class="absolute -right-3 -bottom-3 h-full w-full rounded-[18px] bg-navy" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-[18px] border border-line bg-white">
            <OptionalImage
              name="founder"
              alt={`${about.founder.name}, ${about.founder.role}`}
              class="aspect-square h-auto w-full object-cover"
              widths={[380, 760]}
              sizes="(min-width: 1024px) 380px, 90vw"
            >
              <div class="flex aspect-square w-full items-center justify-center bg-mist text-slate">
                <Icon name="user-round" size={56} />
              </div>
            </OptionalImage>
          </div>
          <span class="absolute -top-3 -left-3 h-6 w-6 rounded-full bg-saffron" aria-hidden="true"></span>
        </div>
        <figcaption class="mt-7 text-center">
          <span class="block font-heading text-xl font-extrabold text-navy">{about.founder.name}</span>
          <span class="block text-sm font-semibold text-slate">{about.founder.role}</span>
        </figcaption>
      </figure>

      <div data-reveal>
        <div><p class="eyebrow">Meet the founder</p></div>
        <h2 id="founder-heading" class="h-accent mt-5 text-3xl font-extrabold md:text-4xl">{about.founder.name}</h2>
        <div class="mt-6 space-y-4 text-lg text-slate">
          {about.founder.bio.map((para) => <p>{para}</p>)}
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            about.founder.highlights.map((h) => (
              <li class="rounded-[14px] border border-line bg-mist p-5">
                <p class="font-heading text-2xl font-extrabold text-navy">{h.value}</p>
                <p class="mt-1 text-sm text-slate">{h.label}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={site.bookingPage} class="btn btn-primary">Talk to {about.founder.name.split(' ')[0]} <Icon name="arrow-right" size={18} /></a>
          {
            about.founder.linkedin && (
              <a href={about.founder.linkedin} class="link-arrow" target="_blank" rel="noopener noreferrer">
                <Icon name="linkedin" size={18} /> Connect on LinkedIn
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="approach-heading">
    <div class="container-site">
      <SectionHeading id="approach-heading" title="Our approach" center />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          about.values.map((v) => (
            <li class="card card-hover p-6" data-reveal>
              <span class="icon-tile">
                <Icon name={v.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold">{v.title}</h3>
              <p class="mt-2 text-slate">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    site.showFacultySection && (
      <section class="section" aria-labelledby="faculty-heading">
        <div class="container-site">
          <SectionHeading id="faculty-heading" title="Faculty and partners" />
          <ul class="mt-10 grid gap-6 md:grid-cols-3">
            {faculty.map((f) => (
              <li class="card p-6">
                <h3 class="text-lg font-bold">{f.name}</h3>
                <p class="text-sm font-semibold text-slate">{f.role}</p>
                <p class="mt-3 text-slate">{f.bio}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>
