---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { processSteps, expectations } from '../data/content';
---

<BaseLayout
  title="How we work"
  description="Diagnose, design, deliver, measure. How GCC Enable builds training programmes around your centre’s mandate and reports on results with your business sponsor."
>
  <PageHero
    title="How we work"
    intro="Four steps that tie every programme to the result your centre needs, and to the measures HQ will recognise."
    breadcrumb={[{ label: 'How we work' }]}
  />

  <section class="section" aria-label="Our four steps">
    <div class="container-site">
      <ol class="relative space-y-8 md:space-y-12">
        {
          processSteps.map((s, i) => (
            <li class="card grid gap-8 p-7 md:grid-cols-[auto_1.3fr_1fr] md:p-10" data-reveal>
              <div class="flex items-center gap-4 md:flex-col md:items-start">
                <span class="relative inline-flex h-16 w-16 items-center justify-center rounded-full border-2 border-teal bg-white text-teal">
                  <Icon name={s.icon} size={28} />
                  <span class="absolute -top-1.5 -right-1.5 inline-flex h-7 w-7 items-center justify-center rounded-full bg-saffron font-heading text-sm font-extrabold text-navy">
                    {i + 1}
                  </span>
                </span>
              </div>
              <div>
                <h2 class="text-2xl font-extrabold md:text-3xl">{s.title}</h2>
                <p class="mt-3 text-lg text-slate">{s.detail}</p>
              </div>
              <ul class="space-y-3 rounded-xl bg-mist p-5">
                {s.points.map((pt) => (
                  <li class="flex gap-3">
                    <Icon name="check" size={20} strokeWidth={2.5} class="mt-0.5 shrink-0 text-teal" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="expect-heading">
    <div class="container-site">
      <SectionHeading id="expect-heading" title="What you can expect" intro="Whatever the programme, every engagement includes:" />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          expectations.map((e) => (
            <li class="card card-hover p-6" data-reveal>
              <span class="icon-tile">
                <Icon name={e.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold">{e.title}</h3>
              <p class="mt-2 text-slate">{e.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Start with a diagnostic conversation." />
</BaseLayout>
