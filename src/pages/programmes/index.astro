---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ProgrammeCard from '../../components/ProgrammeCard.astro';
import CustomWorkshopCard from '../../components/CustomWorkshopCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FormatCards from '../../components/FormatCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import { programmes, programmesByTopic } from '../../data/programmes';
---

<BaseLayout
  title="Programmes"
  description="Training programmes built only for India’s Global Capability Centres (GCCs), across eight topic areas: GenAI and AI literacy, leadership and managers, stakeholder management, product thinking, cloud and security certifications, delivery excellence, domain upskilling and onboarding."
>
  <PageHero
    title="Programmes"
    intro={`${programmes.length} programmes across ${programmesByTopic.length} topic areas, each designed around the realities of Global Capability Centres (GCCs) in India and tailored to your mandate after a short diagnostic. Need something specific? We design custom workshops too.`}
    breadcrumb={[{ label: 'Programmes' }]}
  />

  <!-- Topic jump navigation -->
  <nav
    aria-label="Topic areas"
    class="sticky top-[76px] z-30 border-b border-line bg-white/95 backdrop-blur"
  >
    <div class="container-site">
      <ul class="-mx-1 flex gap-2 overflow-x-auto py-3 [scrollbar-width:none]">
        {
          programmesByTopic.map(({ topic }) => (
            <li class="shrink-0">
              <a
                href={`#${topic.slug}`}
                class="inline-flex items-center gap-2 rounded-full border border-line px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-navy transition-colors hover:border-navy aria-[current=true]:border-navy aria-[current=true]:bg-navy aria-[current=true]:text-white"
                data-topic-link={topic.slug}
              >
                <Icon name={topic.icon} size={16} class="shrink-0" />
                {topic.short}
              </a>
            </li>
          ))
        }
        <li class="shrink-0">
          <a href="#custom" class="inline-flex items-center gap-2 rounded-full border border-dashed border-teal/60 px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-navy hover:border-navy">
            <Icon name="pencil-ruler" size={16} class="shrink-0" />
            Custom workshop
          </a>
        </li>
      </ul>
    </div>
  </nav>

  {
    programmesByTopic.map(({ topic, programmes: list }, i) => (
      <section
        id={topic.slug}
        class:list={['scroll-mt-40 py-14 md:py-20', i % 2 === 1 && 'bg-mist']}
        aria-labelledby={`${topic.slug}-heading`}
        data-topic-section={topic.slug}
      >
        <div class="container-site grid gap-8 lg:grid-cols-[1fr_2.2fr] lg:gap-12">
          <div class="lg:sticky lg:top-44 lg:self-start">
            <span class:list={['icon-tile', i % 2 === 1 && 'bg-white']}>
              <Icon name={topic.icon} />
            </span>
            <p class="mt-5 text-sm font-bold tracking-widest text-slate uppercase">
              Topic {String(i + 1).padStart(2, '0')}
            </p>
            <h2 id={`${topic.slug}-heading`} class="mt-2 text-2xl font-extrabold md:text-[1.7rem]">
              {topic.title}
            </h2>
            <p class="mt-3 text-slate">{topic.summary}</p>
          </div>
          <ul class="grid gap-6 md:grid-cols-2">
            {list.map((p) => (
              <li data-reveal>
                <ProgrammeCard programme={p} showMeta />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section id="custom" class="scroll-mt-40 border-t border-line py-14 md:py-20" aria-label="Custom workshop">
    <div class="container-site grid gap-8 lg:grid-cols-[1fr_2.2fr] lg:gap-12">
      <div>
        <p class="text-sm font-bold tracking-widest text-slate uppercase">Something else?</p>
        <h2 class="mt-2 text-2xl font-extrabold md:text-[1.7rem]">Workshops designed around your mandate</h2>
        <p class="mt-3 text-slate">If your challenge does not fit a topic above, we will design a workshop from scratch.</p>
      </div>
      <div class="max-w-xl"><CustomWorkshopCard headingLevel="h3" /></div>
    </div>
  </section>

  <section class="section bg-mist" aria-labelledby="formats-heading">
    <div class="container-site">
      <SectionHeading
        id="formats-heading"
        title="Formats"
        intro="Every programme can be delivered in the format that fits your centre: on-site in Pune and across India, virtual or blended."
      />
      <div class="mt-12"><FormatCards /></div>
    </div>
  </section>

  <CtaBand title="Not sure which programme fits?" text="Tell us what HQ is asking of your centre. We will suggest a starting point, even if it is not one of ours." />
</BaseLayout>

<script>
  // Highlight the topic chip for the section in view
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-topic-link]');
  const sections = document.querySelectorAll<HTMLElement>('[data-topic-section]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const slug = (entry.target as HTMLElement).dataset.topicSection;
          links.forEach((a) => {
            const active = a.dataset.topicLink === slug;
            a.setAttribute('aria-current', String(active));
            if (active) a.closest('ul')?.scrollTo({ left: a.parentElement!.offsetLeft - 16, behavior: 'smooth' });
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
