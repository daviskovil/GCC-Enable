---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AudienceCard from '../../components/AudienceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { audiences } from '../../data/audiences';
---

<BaseLayout
  title="Who we help"
  description="GCC Enable works with site leaders, HR and L&D heads, and engineering and CoE heads in Global Capability Centres (GCCs) across India, and with centres setting up in India."
>
  <PageHero
    title="Who we help"
    intro="Different leaders in a Global Capability Centre (GCC) need different things from learning. Start with the role closest to yours."
    breadcrumb={[{ label: 'Who we help' }]}
  />
  <section class="section" aria-label="Roles we work with">
    <div class="container-site">
      <ul class="grid gap-6 sm:grid-cols-2">
        {
          audiences.map((a) => (
            <li data-reveal>
              <AudienceCard audience={a} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
