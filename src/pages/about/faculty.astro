---
/** Listed in the menu only when site.showFacultySection is true; until then the page is noindex. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { faculty } from '../../data/content';

const live = site.showFacultySection;
---

<BaseLayout
  title="Faculty"
  description="The practitioners who lead GCC Enable programmes: people who have delivered global IT and run teams at scale."
  noindex={!live}
>
  <PageHero
    title="Faculty"
    intro="Our programmes are led by practitioners who have delivered global work at scale, not trainers reading from slides."
    breadcrumb={[{ label: 'About', href: '/about/' }, { label: 'Faculty' }]}
  />
  <section class="section" aria-label="Faculty members">
    <div class="container-site">
      {
        live ? (
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {faculty.map((f) => (
              <li class="card p-6" data-reveal>
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-mist text-slate">
                  <Icon name="user-round" size={28} />
                </span>
                <h2 class="mt-5 text-lg font-bold">{f.name}</h2>
                <p class="text-sm font-semibold text-slate">{f.role}</p>
                <p class="mt-3 text-slate">{f.bio}</p>
              </li>
            ))}
          </ul>
        ) : (
          <div class="card mx-auto max-w-3xl p-7 text-center md:p-10">
            <h2 class="text-2xl font-bold">Faculty profiles are coming soon</h2>
            <p class="mt-2 text-slate">Interested in teaching with us?</p>
            <a href="/careers/" class="btn btn-primary mt-6">Join as faculty</a>
          </div>
        )
      }
    </div>
  </section>
  <CtaBand />
</BaseLayout>
