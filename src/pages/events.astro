---
/** Shown in the menu only when site.showEvents is true; until then the page is noindex and shows a sign-up prompt. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { events } from '../data/events';

const live = site.showEvents;
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter((e) => e.date < today).sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });

const eventLd = live
  ? upcoming.map((e) => ({
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: e.title,
      description: e.description,
      startDate: e.date,
      eventAttendanceMode:
        e.location === 'Online' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
      location:
        e.location === 'Online'
          ? { '@type': 'VirtualLocation', url: e.registerUrl || site.url }
          : { '@type': 'Place', name: e.location, address: { '@type': 'PostalAddress', addressLocality: e.location, addressCountry: 'IN' } },
      organizer: { '@type': 'Organization', name: site.name, url: site.url },
    }))
  : [];
---

<BaseLayout
  title="Events"
  description="Open workshops, roundtables and webinars for GCC leaders, managers and L&D teams in India."
  noindex={!live}
  jsonLd={eventLd}
>
  <PageHero
    title="Events"
    intro="Open workshops, leader roundtables and webinars: a simple way to meet us and other GCC leaders."
    breadcrumb={[{ label: 'Events' }]}
  />

  <section class="section" aria-labelledby="upcoming-heading">
    <div class="container-site">
      <h2 id="upcoming-heading" class="h-accent text-3xl font-extrabold">Upcoming</h2>
      {
        live && upcoming.length > 0 ? (
          <ul class="mt-10 space-y-5">
            {upcoming.map((e) => (
              <li class="card grid gap-5 p-6 md:grid-cols-[180px_1fr_auto] md:items-center md:p-7" data-reveal>
                <div>
                  <p class="font-heading text-lg font-bold text-navy">{fmt(e.date)}</p>
                  {e.time && <p class="text-sm text-slate">{e.time}</p>}
                </div>
                <div>
                  <p class="flex flex-wrap items-center gap-2 text-sm">
                    <span class="rounded-full bg-mist px-3 py-1 font-semibold text-navy">{e.type}</span>
                    <span class="flex items-center gap-1 text-slate">
                      <Icon name="map-pin" size={15} class="text-teal" />
                      {e.location}
                    </span>
                  </p>
                  <h3 class="mt-2 text-xl font-bold">{e.title}</h3>
                  <p class="mt-1 text-slate">{e.description}</p>
                </div>
                {e.registerUrl ? (
                  <a href={e.registerUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    Register
                  </a>
                ) : (
                  <span class="text-sm font-semibold text-slate">Registration opens soon</span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <div class="card mt-10 grid max-w-3xl gap-6 p-7 md:p-10">
            <div>
              <h3 class="text-2xl font-bold">No events scheduled right now</h3>
              <p class="mt-2 text-slate">Subscribe to the newsletter and we will tell you when the next one is announced.</p>
            </div>
            <NewsletterForm id="events-newsletter" />
          </div>
        )
      }

      {
        live && past.length > 0 && (
          <div class="mt-16">
            <h2 class="text-2xl font-extrabold">Past events</h2>
            <ul class="mt-6 divide-y divide-line rounded-[14px] border border-line">
              {past.map((e) => (
                <li class="flex flex-col gap-1 px-5 py-4 md:flex-row md:items-center md:gap-6">
                  <span class="w-44 shrink-0 text-sm text-slate">{fmt(e.date)}</span>
                  <span class="font-semibold text-navy">{e.title}</span>
                  <span class="text-sm text-slate md:ml-auto">
                    {e.type} · {e.location}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
